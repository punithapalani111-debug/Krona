
import 'package:flutter/material.dart';

const String APP_USERNAME = 'Krona';
const String APP_PASSWORD = '18052013';

void main() => runApp(const KronaApp());

class KronaApp extends StatelessWidget {
  const KronaApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'A.KRONA',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        brightness: Brightness.dark,
        scaffoldBackgroundColor: const Color(0xFF101820),
        colorScheme: ColorScheme.fromSeed(
          seedColor: Colors.lightBlue,
          brightness: Brightness.dark,
        ),
        useMaterial3: true,
      ),
      home: const LoginPage(),
    );
  }
}

class LoginPage extends StatefulWidget {
  const LoginPage({super.key});

  @override
  State<LoginPage> createState() => _LoginPageState();
}

class _LoginPageState extends State<LoginPage> {
  final username = TextEditingController();
  final password = TextEditingController();
  bool showPassword = false;

  void login() {
    if (username.text.trim() == APP_USERNAME &&
        password.text == APP_PASSWORD) {
      Navigator.pushReplacement(
        context,
        MaterialPageRoute(
          builder: (_) => const MainDashboard(),
        ),
      );
    } else {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Incorrect username or password'),
        ),
      );
    }
  }

  @override
  void dispose() {
    username.dispose();
    password.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Center(
        child: SingleChildScrollView(
          padding: const EdgeInsets.all(25),
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              const Icon(Icons.smart_toy,
                  size: 100, color: Colors.lightBlueAccent),
              const SizedBox(height: 20),
              const Text(
                'A.KRONA',
                style: TextStyle(
                  fontSize: 32,
                  fontWeight: FontWeight.bold,
                  letterSpacing: 4,
                ),
              ),
              const Text('Robot Control System'),
              const SizedBox(height: 40),
              TextField(
                controller: username,
                decoration: const InputDecoration(
                  labelText: 'Username',
                  prefixIcon: Icon(Icons.person),
                  border: OutlineInputBorder(),
                ),
              ),
              const SizedBox(height: 20),
              TextField(
                controller: password,
                obscureText: !showPassword,
                onSubmitted: (_) => login(),
                decoration: InputDecoration(
                  labelText: 'Password',
                  prefixIcon: const Icon(Icons.lock),
                  border: const OutlineInputBorder(),
                  suffixIcon: IconButton(
                    icon: Icon(showPassword
                        ? Icons.visibility_off
                        : Icons.visibility),
                    onPressed: () {
                      setState(() {
                        showPassword = !showPassword;
                      });
                    },
                  ),
                ),
              ),
              const SizedBox(height: 25),
              SizedBox(
                width: double.infinity,
                height: 50,
                child: ElevatedButton(
                  onPressed: login,
                  child: const Text('LOGIN'),
                ),
              ),
              const SizedBox(height: 20),
              const Text('Welcome to A.KRONA'),
            ],
          ),
        ),
      ),
    );
  }
}

class MainDashboard extends StatefulWidget {
  const MainDashboard({super.key});

  @override
  State<MainDashboard> createState() => _MainDashboardState();
}

class _MainDashboardState extends State<MainDashboard> {
  int page = 0;
  bool connected = false;
  bool voiceEnabled = false;
  bool guestMode = false;
  bool demoMode = false;
  bool sleepMode = false;

  String emotion = 'Happy';
  String lastCommand = 'No command';

  final titles = [
    'Home',
    'Remote Control',
    'Voice Control',
    'Emotions',
    'Modes',
    'Settings',
  ];

  void sendCommand(String command) {
    setState(() => lastCommand = command);
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        content: Text('Command: $command'),
        duration: const Duration(seconds: 1),
      ),
    );
  }

  Widget robotEyes() {
    Widget eye() => Container(
          width: 55,
          height: 55,
          decoration: BoxDecoration(
            color: Colors.lightBlueAccent,
            borderRadius: BorderRadius.circular(20),
            boxShadow: [
              BoxShadow(
                color: Colors.blue.withOpacity(0.5),
                blurRadius: 20,
              ),
            ],
          ),
        );

    return Container(
      padding: const EdgeInsets.all(30),
      decoration: BoxDecoration(
        color: const Color(0xFF172B3A),
        borderRadius: BorderRadius.circular(30),
      ),
      child: Row(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [eye(), const SizedBox(width: 30), eye()],
      ),
    );
  }

  Widget homePage() {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(20),
      child: Column(
        children: [
          robotEyes(),
          const SizedBox(height: 25),
          const Text(
            'Hello! I am KRONA',
            style: TextStyle(
                fontSize: 25, fontWeight: FontWeight.bold),
          ),
          const SizedBox(height: 10),
          Text(
            connected ? 'Connected' : 'Disconnected',
            style: TextStyle(
              color: connected
                  ? Colors.greenAccent
                  : Colors.redAccent,
            ),
          ),
          const SizedBox(height: 20),
          ElevatedButton.icon(
            onPressed: () {
              setState(() => connected = !connected);
            },
            icon: const Icon(Icons.wifi),
            label: Text(connected ? 'Disconnect' : 'Connect'),
          ),
          const SizedBox(height: 20),
          Card(
            child: ListTile(
              leading: const Icon(Icons.mood),
              title: const Text('Current Emotion'),
              subtitle: Text(emotion),
            ),
          ),
          Card(
            child: ListTile(
              leading: const Icon(Icons.gamepad),
              title: const Text('Last Command'),
              subtitle: Text(lastCommand),
            ),
          ),
          Card(
            child: ListTile(
              leading: const Icon(Icons.mic),
              title: const Text('Voice Control'),
              subtitle: Text(
                  voiceEnabled ? 'Enabled' : 'Disabled'),
            ),
          ),
        ],
      ),
    );
  }

  Widget controlButton(IconData icon, String command) {
    return Padding(
      padding: const EdgeInsets.all(8),
      child: ElevatedButton(
        onPressed: () => sendCommand(command),
        style: ElevatedButton.styleFrom(
          shape: const CircleBorder(),
          padding: const EdgeInsets.all(22),
        ),
        child: Icon(icon, size: 30),
      ),
    );
  }

  Widget remotePage() {
    return Column(
      mainAxisAlignment: MainAxisAlignment.center,
      children: [
        const Text(
          'REMOTE CONTROL',
          style: TextStyle(
              fontSize: 22, fontWeight: FontWeight.bold),
        ),
        const SizedBox(height: 30),
        controlButton(Icons.arrow_upward, 'UP'),
        Row(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            controlButton(Icons.arrow_back, 'LEFT'),
            controlButton(Icons.stop, 'STOP'),
            controlButton(Icons.arrow_forward, 'RIGHT'),
          ],
        ),
        controlButton(Icons.arrow_downward, 'DOWN'),
        const SizedBox(height: 25),
        Text('Last Command: $lastCommand'),
        const SizedBox(height: 10),
        const Text('Prototype controls only'),
      ],
    );
  }

  Widget voicePage() {
    return Center(
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          Icon(
            voiceEnabled ? Icons.mic : Icons.mic_off,
            size: 100,
            color: Colors.lightBlueAccent,
          ),
          const SizedBox(height: 25),
          Text(
            voiceEnabled
                ? 'Voice Control Enabled'
                : 'Voice Control Disabled',
          ),
          const SizedBox(height: 25),
          ElevatedButton(
            onPressed: () {
              setState(() => voiceEnabled = !voiceEnabled);
            },
            child: Text(
              voiceEnabled ? 'Disable Voice' : 'Enable Voice',
            ),
          ),
          const SizedBox(height: 25),
          const Text('Wake phrase: Hey Krona'),
          const SizedBox(height: 15),
          const Text('Voice recognition is not connected yet.'),
        ],
      ),
    );
  }

  Widget emotionsPage() {
    final emotions = [
      'Happy', 'Sad', 'Sleepy', 'Angry',
      'Surprised', 'Curious', 'Love', 'Normal'
    ];

    final icons = [
      Icons.sentiment_very_satisfied,
      Icons.sentiment_dissatisfied,
      Icons.bedtime,
      Icons.mood_bad,
      Icons.star,
      Icons.search,
      Icons.favorite,
      Icons.face,
    ];

    return GridView.builder(
      padding: const EdgeInsets.all(20),
      gridDelegate:
          const SliverGridDelegateWithFixedCrossAxisCount(
        crossAxisCount: 2,
        crossAxisSpacing: 15,
        mainAxisSpacing: 15,
      ),
      itemCount: emotions.length,
      itemBuilder: (context, index) {
        return Card(
          child: InkWell(
            onTap: () {
              setState(() => emotion = emotions[index]);
            },
            child: Column(
              mainAxisAlignment: MainAxisAlignment.center,
              children: [
                Icon(
                  icons[index],
                  size: 40,
                  color: Colors.lightBlueAccent,
                ),
                const SizedBox(height: 10),
                Text(emotions[index]),
              ],
            ),
          ),
        );
      },
    );
  }

  Widget modesPage() {
    return ListView(
      padding: const EdgeInsets.all(20),
      children: [
        SwitchListTile(
          title: const Text('Guest Mode'),
          subtitle: const Text('Limited access'),
          value: guestMode,
          onChanged: (value) {
            setState(() => guestMode = value);
          },
        ),
        const Divider(),
        SwitchListTile(
          title: const Text('Demo Mode'),
          subtitle: const Text('Robot demonstrations'),
          value: demoMode,
          onChanged: (value) {
            setState(() => demoMode = value);
          },
        ),
        const Divider(),
        SwitchListTile(
          title: const Text('Sleep Mode'),
          subtitle: const Text('Reduce robot activity'),
          value: sleepMode,
          onChanged: (value) {
            setState(() => sleepMode = value);
          },
        ),
      ],
    );
  }

  Widget settingsPage() {
    return ListView(
      padding: const EdgeInsets.all(20),
      children: [
        const ListTile(
          leading: Icon(Icons.person),
          title: Text('Account'),
          subtitle: Text('Krona'),
        ),
        const Divider(),
        const ListTile(
          leading: Icon(Icons.wifi),
          title: Text('Wi-Fi'),
          subtitle: Text('Robot connection settings'),
        ),
        const Divider(),
        const ListTile(
          leading: Icon(Icons.language),
          title: Text('Language'),
          subtitle: Text('English / Tamil / Hindi'),
        ),
        const Divider(),
        const ListTile(
          leading: Icon(Icons.security),
          title: Text('Security'),
          subtitle: Text('Prototype login'),
        ),
        const Divider(),
        const ListTile(
          leading: Icon(Icons.info),
          title: Text('About A.KRONA'),
          subtitle: Text('Robot Control App'),
        ),
        const Divider(),
        ListTile(
          leading: const Icon(Icons.logout, color: Colors.red),
          title: const Text('Logout'),
          onTap: () {
            Navigator.pushReplacement(
              context,
              MaterialPageRoute(
                builder: (_) => const LoginPage(),
              ),
            );
          },
        ),
      ],
    );
  }

  Widget currentPage() {
    switch (page) {
      case 0: return homePage();
      case 1: return remotePage();
      case 2: return voicePage();
      case 3: return emotionsPage();
      case 4: return modesPage();
      case 5: return settingsPage();
      default: return homePage();
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text('A.KRONA - ${titles[page]}'),
        backgroundColor: const Color(0xFF172B3A),
      ),
      body: currentPage(),
      bottomNavigationBar: NavigationBar(
        selectedIndex: page,
        onDestinationSelected: (index) {
          setState(() => page = index);
        },
        destinations: const [
          NavigationDestination(
            icon: Icon(Icons.home), label: 'Home'),
          NavigationDestination(
            icon: Icon(Icons.gamepad), label: 'Remote'),
          NavigationDestination(
            icon: Icon(Icons.mic), label: 'Voice'),
          NavigationDestination(
            icon: Icon(Icons.mood), label: 'Emotions'),
          NavigationDestination(
            icon: Icon(Icons.settings), label: 'Modes'),
          NavigationDestination(
            icon: Icon(Icons.tune), label: 'Settings'),
        ],
      ),
    );
  }
}
